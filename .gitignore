# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/
env/

# Local secrets and environment
.env
.env.local

# Runtime data — never commit live project databases or generated files
*.db
*.db-journal
*.db-wal
*.db-shm
logs/*
!logs/.gitkeep
backups/*
!backups/.gitkeep
exports/*
!exports/.gitkeep
documents/*
!documents/.gitkeep
*.log

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
