# PipeAgent Enterprise Configuration
PIPEAGENT_DATABASE_URL=sqlite:///./pipeagent.db
# Shared site server (overrides File → Database Connection):
# PIPEAGENT_DATABASE_URL=postgresql+psycopg://pipeagent:change-me@localhost:5432/pipeagent
# PIPEAGENT_DATABASE_URL=mssql+pyodbc://sa:change-me@localhost\\SQLEXPRESS/PipeAgent?driver=ODBC+Driver+17+for+SQL+Server&TrustServerCertificate=yes
# Windows auth:
# PIPEAGENT_DATABASE_URL=mssql+pyodbc://@localhost\\SQLEXPRESS/PipeAgent?driver=ODBC+Driver+17+for+SQL+Server&trusted_connection=yes

PIPEAGENT_API_ENABLED=true
PIPEAGENT_API_HOST=127.0.0.1
PIPEAGENT_API_PORT=8765

# Bootstrap (PostgreSQL requires an explicit password; SQLite may use insecure defaults)
# PIPEAGENT_BOOTSTRAP_ADMIN_PASSWORD=change-me-now
# PIPEAGENT_ALLOW_INSECURE_DEFAULTS=false

# Optional OIDC / SSO
PIPEAGENT_OIDC_ISSUER_URL=
PIPEAGENT_OIDC_AUDIENCE=PipeAgent
PIPEAGENT_OIDC_REQUIRED=false

PIPEAGENT_INTEGRATION_TIMEOUT=20
PIPEAGENT_SYNC_BATCH_SIZE=100
PIPEAGENT_BIM_ROOT=./documents
# PIPEAGENT_API_TOKEN_PEPPER=generate-a-long-random-string

# Commercial / customer portal
PIPEAGENT_LICENSE_PURCHASE_URL=
